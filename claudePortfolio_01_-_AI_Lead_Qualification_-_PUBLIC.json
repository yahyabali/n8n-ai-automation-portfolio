    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a sales lead qualification assistant.\n\nAnalyse this incoming lead:\n\nName: {{ $json.body.name }}\nEmail: {{ $json.body.email }}\nCompany: {{ $json.body.company }}\nMessage: {{ $json.body.message }}\nBudget: {{ $json.body.budget }}\n\nReturn ONLY valid JSON in this exact format:\n\n{\n  \"lead_score\": 0,\n  \"priority\": \"hot\",\n  \"intent\": \"\",\n  \"reason\": \"\"\n}\n\nRules:\n- lead_score must be an integer from 0 to 100\n- priority must be one of: hot, warm, low\n- hot = strong buying intent, clear business need, good budget or urgency\n- warm = some interest but unclear timing, budget, or need\n- low = weak intent, vague enquiry, unsuitable lead, or little buying signal\n- intent should be a short category such as \"automation project\", \"consulting\", \"support\", or \"general enquiry\"\n- reason should be one short sentence\n- Do not include markdown or any text outside the JSON",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        448,
        -192
      ],
